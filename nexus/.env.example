# Copy to .env:  cp .env.example .env   (.env is in .gitignore)
# Read by setup.py. Use letters, digits, "-" and "_" in passwords, at least 8 characters.

# The admin password setup.py sets in place of the generated one
NEXUS_ADMIN_PASSWORD=change-me-nexus-admin

# The user Jenkins publishes with: role travelagency-ci, access only to the two TravelAgency repositories.
# Put the same two values into jenkins/.env
NEXUS_CI_USER=jenkins
NEXUS_CI_PASSWORD=change-me-nexus-ci

# Nexus Community Edition is free under the Sonatype End User License Agreement:
#   https://links.sonatype.com/products/nxrm/ce-eula
# Read it and write yes to accept it. Until then setup.py stops before changing anything else.
NEXUS_ACCEPT_EULA=
