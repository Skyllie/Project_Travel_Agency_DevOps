# Copy to .env:  cp .env.example .env   (.env is in .gitignore)

# Password of the PostgreSQL user "sonar" (docker-compose.yml). Letters, digits, "-" and "_"
SONAR_DB_PASSWORD=change-me-sonar-db

# The admin password setup.py sets in place of the default admin/admin. SonarQube requires
# at least 12 characters with an uppercase letter, a lowercase letter, a digit and a special character
SONAR_ADMIN_PASSWORD=change-me-Sonar-1!
