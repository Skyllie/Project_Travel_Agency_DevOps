# Copy to .env:  cp .env.example .env   (.env is in .gitignore)
# Use letters, digits, "-" and "_" in passwords.

JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-jenkins
JENKINS_PORT=8081
# The address you open Jenkins at, e.g. http://192.168.58.130:8081/ (hostname -I shows the IP)
JENKINS_PUBLIC_URL=http://localhost:8081/

# Database passwords for the deployed stack (Jenkins credentials travel-db-password / travel-db-root-password)
TRAVEL_DB_PASSWORD=change-me
TRAVEL_DB_ROOT_PASSWORD=change-me-root

# Repository and branch with the Jenkinsfile
REPO_URL=https://github.com/Skyllie/Project_Travel_Agency_DevOps.git
REPO_BRANCH=jenkins

# Group id of /var/run/docker.sock on the host. Add it with:
#   echo "DOCKER_GID=$(getent group docker | cut -d: -f3)" >> .env
