# Generated by Terraform from templates/nginx.conf.tftpl — do not edit inside the container.
# algorithm = ${algorithm}, sticky = ${sticky}, servers = ${length(nodes)}

upstream travel_pool {
    zone travel_pool 64k;
%{ if directive != "" ~}
    ${directive}
%{ endif ~}
%{ for s in pool ~}
    server ${s.ip}:8080 ${s.params};   # ${s.name}
%{ endfor ~}
    keepalive 16;
}

# One upstream per server for sticky sessions; the other servers are its backups
%{ for n in nodes ~}
upstream node_${n.name} {
    zone node_${n.name} 64k;
    server ${n.ip}:8080;
%{ for other in nodes ~}
%{ if other.name != n.name ~}
    server ${other.ip}:8080 backup;
%{ endif ~}
%{ endfor ~}
}
%{ endfor ~}

# Tomcat adds its jvmRoute to the session id: JSESSIONID=...E2.app2
map $cookie_JSESSIONID $sticky_upstream {
%{ for n in nodes ~}
    ~\.${n.name}$  node_${n.name};
%{ endfor ~}
    default        travel_pool;
}

# Name of the server that answered (X-Served-By header and the log)
map $upstream_addr $served_by {
%{ for n in nodes ~}
    ~${replace(n.ip, ".", "\\.")}:8080$  ${n.name};
%{ endfor ~}
    default  $upstream_addr;
}

log_format balancer '$remote_addr "$request" $status -> $served_by '
                    '(tried: $upstream_addr, $upstream_response_time s)';

server {
    listen 80;
    server_name _;
    server_tokens off;
    access_log /var/log/nginx/access.log balancer;

    location / {
        proxy_pass http://${sticky ? "$sticky_upstream" : "travel_pool"};

        proxy_http_version 1.1;
        proxy_set_header Connection        "";
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout     2s;
        proxy_next_upstream       error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 3;

        add_header X-Served-By $served_by always;
    }

    # Counters for the monitoring (nginx-prometheus-exporter): only Nginx itself and the Docker network
    location = /nginx-status {
        stub_status;
        access_log off;
        allow 127.0.0.1;
        allow ${subnet};
        deny all;
    }
}
