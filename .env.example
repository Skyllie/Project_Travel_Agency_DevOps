# Copy to .env and change the passwords:  cp .env.example .env
# .env is in .gitignore and never goes to GitHub.
# Use letters, digits, "-" and "_" in passwords: "$" and quotes have a special meaning here.

MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=travelagency
DB_USER=travel
DB_PASSWORD=change-me

# Port of the load balancer on the Docker host
LB_PORT=80

# Balancing algorithm: a file name from lb/upstreams/ without ".conf":
#   round_robin | weighted | least_conn | ip_hash | hash | random | backup
LB_ALGORITHM=round_robin

# Sticky sessions by the Tomcat jvmRoute in JSESSIONID: on | off
LB_STICKY=on

# JVM memory for each Tomcat (three of them run)
JAVA_OPTS=-Xmx320m
