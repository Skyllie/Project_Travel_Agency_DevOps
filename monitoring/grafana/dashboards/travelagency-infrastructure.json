          "legendFormat": "load 1m"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_load5{job=\"node\"}",
          "legendFormat": "load 5m"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(count by (cpu) (node_cpu_seconds_total{job=\"node\"}))",
