      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Load average and CPU cores",
      "description": "Load above the number of cores means processes wait for CPU",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
