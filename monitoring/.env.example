# Copy to .env:  cp .env.example .env   (.env is in .gitignore)
# Use letters, digits, "-" and "_" in passwords, at least 8 characters.

# Grafana admin password (only used when Grafana starts the first time; later change it in Grafana)
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Password of the MySQL user "exporter" (read-only statistics); setup.py creates the user with it
MYSQL_EXPORTER_PASSWORD=change-me-exporter

# First three parts of the subnet of the Terraform stack (variable subnet, 172.31.0.0/24 by default)
TF_NET_PREFIX=172.31.0
